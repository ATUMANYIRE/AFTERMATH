# ==============================================================================
# AFTERMATH — Configuration Environment Template
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=info

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection
# Local default: async SQLite (zero external dependencies required for immediate startup)
DATABASE_URL=sqlite+aiosqlite:///./aftermath.db
# Production / Docker Compose default (PostgreSQL 16):
# DATABASE_URL=postgresql+asyncpg://aftermath:aftermath@postgres:5432/aftermath

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitLab Duo & DevSecOps Platform Integration
# Required for real GitLab Duo Agent Platform interactions in the hackathon.
GITLAB_INSTANCE_URL=https://gitlab.com
GITLAB_PROJECT_PATH=atumanyire/aftermath
# Provide your Personal Access Token with api, read_api, and read_repository scopes:
GITLAB_ACCESS_TOKEN=
# Set to true once valid credentials with Duo access are configured:
GITLAB_DUO_ENABLED=false

# Synthetic Payment Service Sandbox
SYNTHETIC_PAYMENT_LATENCY_MS=120
SYNTHETIC_PAYMENT_FAILURE_INJECTION=false
